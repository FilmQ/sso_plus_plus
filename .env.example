# Environment variables of the SST server (server/lib/config.dart).
# The values below are the defaults. They agree with docker-compose.yml.
# Dart does not read this file. Export the variables in your shell if you change them.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sst
TEST_DB_NAME=sst_test
DB_USER=sst
DB_PASSWORD=sst

SERVER_PORT=8080
# The key that signs login tokens. Use a long random value outside development.
SESSION_SECRET=dev-only-secret
# The folder for uploaded files, relative to server/.
STORAGE_DIR=storage

# The Flutter app reads the server address at build time:
#   flutter run --dart-define=API_BASE_URL=http://localhost:8080
# On the Android emulator, use http://10.0.2.2:8080.
